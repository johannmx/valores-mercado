{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "security:minimumReleaseAgeNpm"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group minor and patch development dependencies",
      "matchPackageNames": ["*"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Development Dependencies (non-major)"
    },
    {
      "description": "Keep TypeScript major updates separate to avoid peer dependency conflicts",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Keep Tailwind CSS major updates separate due to breaking configuration changes",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Keep ESLint major updates separate",
      "matchPackageNames": ["eslint", "@eslint/*", "typescript-eslint", "eslint-plugin-*"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ],
  "timezone": "America/Argentina/Buenos_Aires"
}
